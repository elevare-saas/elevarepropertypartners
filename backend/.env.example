# Elevare backend configuration. Copy to .env and fill in. Never commit .env.
# Empty values use the default shown in the comment. Everything is checked at start-up:
# the server refuses to start and lists every problem if a value is invalid.

# ─── Server ──────────────────────────────────────────────────────────────────
# development | production  (production turns on Secure cookies and requires SESSION_SECRET)
NODE_ENV=development
# Port the API listens on (the frontend dev server proxies /api and /uploads here)
PORT=4000
# Express "trust proxy": loopback (default), a hop count like 1, or true behind a cloud load balancer.
# Needed so client IPs (rate limits) and HTTPS detection are right behind a proxy.
TRUST_PROXY=loopback
# error | warn | info | debug   (default: debug in development, info in production)
LOG_LEVEL=

# ─── Database: Postgres on Supabase (admins, sessions, listings, website leads) ─
# Supabase → project → Connect → Transaction pooler (port 6543; works over IPv4). Required.
#   postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# A local Postgres also works: postgresql://postgres:<password>@localhost:5432/elevare
DATABASE_URL=
# Maximum connections in the pool (default 10; 3 on Vercel)
DATABASE_POOL_MAX=

# ─── Website / CORS ──────────────────────────────────────────────────────────
# The public website's URL: allowed to call the API, and used for links in emails
FRONTEND_URL=http://localhost:3000
# Extra comma-separated origins allowed to call the API from a browser,
# e.g. https://www.elevarepropertypartners.com,https://staging.elevarepropertypartners.com
CORS_ORIGINS=

# Public address of the website, used for canonical URLs, the sitemap and structured data
# (default: FRONTEND_URL). Set it to the live domain in production, e.g. https://www.elevarepropertypartners.com
SITE_URL=
# Optional: path to the built website (elevare-frontend/dist). When set, this server also serves the website and
# gives every page its own title, description, canonical, hreflang and JSON-LD (best for search engines).
# Leave empty if the website is hosted elsewhere; then proxy /api, /uploads and /sitemap.xml to this server.
FRONTEND_DIST=

# ─── Sessions & cookies (admin sign-in) ──────────────────────────────────────
# Secret that signs the session cookie: at least 32 random characters, required in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=
# Cookie name (default elevare_session)
SESSION_COOKIE_NAME=elevare_session
# How long a sign-in lasts, in days (default 7)
SESSION_TTL_DAYS=7
# Cookie domain, e.g. .elevarepropertypartners.com to share it with subdomains. Empty = current host only.
COOKIE_DOMAIN=
# true | false   (default: true when NODE_ENV=production). Must be true when served over HTTPS.
COOKIE_SECURE=
# lax (default) | strict | none.  Use none only if the website and API are on different sites;
# it needs COOKIE_SECURE=true.
COOKIE_SAMESITE=lax

# ─── AI listing drafts (Properties → Add with AI) ────────────────────────────
# Claude API key from https://platform.claude.com/settings/keys. Empty = the AI button says it isn't set up.
ANTHROPIC_API_KEY=
# Claude model that writes the drafts (default claude-opus-5-5)
AI_MODEL=claude-opus-5-5

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
# Leave SMTP_HOST empty to turn email off.
SMTP_HOST=
# 587 (STARTTLS, default) or 465 (TLS)
SMTP_PORT=587
# true for port 465 (default: true only when SMTP_PORT=465)
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown on outgoing emails
MAIL_FROM="Elevare Property Partners <no-reply@elevarepropertypartners.com>"
# Comma-separated addresses that get an email for every new website lead. Empty = no lead emails.
LEADS_NOTIFY_EMAIL=

# ─── Lead webhook ────────────────────────────────────────────────────────────
# Every website lead is also POSTed here as JSON (CRM, Zapier, Make, Slack…). Empty = off.
# Body: {"event":"lead.created","lead":{…},"sentAt":"…"}. Retried 3 times on network errors / 5xx.
LEAD_WEBHOOK_URL=
# Optional shared secret: requests then carry X-Elevare-Signature: sha256=<HMAC-SHA256 of the body>
LEAD_WEBHOOK_SECRET=

# ─── Limits & storage ────────────────────────────────────────────────────────
# Maximum JSON request body (default 200kb)
JSON_BODY_LIMIT=200kb
# Folder for uploaded listing photos (default ./uploads). Back it up.
UPLOAD_DIR=uploads
# Maximum photo size in MB (default 8)
UPLOAD_MAX_MB=8
# Failed sign-ins allowed per email + IP before a lock-out (default 8) ...
LOGIN_MAX_ATTEMPTS=8
# ... and how long the lock-out window lasts, in minutes (default 15)
LOGIN_WINDOW_MINUTES=15
# Website lead submissions allowed per IP per hour (default 20)
LEADS_PER_HOUR_PER_IP=20

# ─── First Super Admin ───────────────────────────────────────────────────────
# Created on first start, only when the admins collection is empty.
# If ADMIN_PASSWORD is empty, a random one is generated and printed once in the log.
ADMIN_EMAIL=admin@elevarepropertypartners.com
ADMIN_PASSWORD=
