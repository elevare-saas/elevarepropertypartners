# Elevare production settings: copy to backend/.env on the server and fill in the <…> values.
# One domain: this server answers the website (/), the API (/api), uploads (/uploads) and /sitemap.xml.
# Every other setting is documented in .env.example.

NODE_ENV=production
# The app listens here; nginx (or your host's proxy) forwards https://<your domain> to it
PORT=4000
# Behind one reverse proxy (nginx, a load balancer): 1. Directly on the internet: loopback
TRUST_PROXY=1
LOG_LEVEL=info

# ─── Domain ──────────────────────────────────────────────────────────────────
# The live address, https, no trailing slash. Used for CORS, canonical URLs, the sitemap and emails.
FRONTEND_URL=https://www.elevarepropertypartners.com
SITE_URL=https://www.elevarepropertypartners.com
# Also allow the bare domain if it serves the site too (better: redirect it to www in nginx)
CORS_ORIGINS=https://elevarepropertypartners.com
# Empty = serve ../elevare-frontend/dist (build it first). "off" = the website is hosted elsewhere.
FRONTEND_DIST=

# ─── Database ────────────────────────────────────────────────────────────────
# Local MongoDB, or an Atlas mongodb+srv:// address
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=elevare

# ─── Sessions (admin sign-in) ────────────────────────────────────────────────
# Required, at least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=<paste a generated secret>
# Secure cookies need HTTPS (on by default in production)
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ─── Leads ───────────────────────────────────────────────────────────────────
# Email for each new lead (needs the SMTP settings below), and/or a CRM / Zapier / Make webhook
LEADS_NOTIFY_EMAIL=
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Elevare Property Partners <no-reply@elevarepropertypartners.com>"

# ─── Storage ─────────────────────────────────────────────────────────────────
# Uploaded listing photos. Keep this folder (and MongoDB) in your backups.
UPLOAD_DIR=uploads

# ─── First Super Admin (only used when the admins collection is empty) ───────
ADMIN_EMAIL=admin@elevarepropertypartners.com
ADMIN_PASSWORD=
