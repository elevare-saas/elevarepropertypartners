{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix backend && npm ci --prefix elevare-frontend",
  "buildCommand": "npm run build --prefix elevare-frontend && npm run build --prefix backend",
  "outputDirectory": "elevare-frontend/dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{backend/dist/**,elevare-frontend/dist/index.html}",
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
