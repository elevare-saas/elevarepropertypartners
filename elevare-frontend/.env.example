# Base URL of the Elevare API (../backend). Leave empty when the API is served from the same domain
# (the Vite dev server proxies /api and /uploads to http://localhost:4000; in production use a reverse proxy).
# Set it only if the API is on another domain, e.g. https://api.elevarepropertypartners.com,
# and add this website's URL to the backend's FRONTEND_URL / CORS_ORIGINS.
VITE_API_URL=

# Public address of the website (no trailing slash): canonical URLs, hreflang, Open Graph and structured data.
# Default: https://www.elevarepropertypartners.com. If the live domain differs, also update public/robots.txt.
VITE_SITE_URL=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (GA4 → Admin → Data streams → Web).
# Empty = analytics off. Visitors are asked for consent before analytics cookies are used (Consent Mode v2).
# Events sent: page_view, generate_lead (mark it as a key event in GA4), view_item, contact.
VITE_GA_MEASUREMENT_ID=

# The WhatsApp number, email, areas and market estimates are not set here: they're in the database,
# edited in the dashboard under Website settings.
